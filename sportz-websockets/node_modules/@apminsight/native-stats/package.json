{
  "name": "@apminsight/native-stats",
  "version": "1.0.0",
  "description": "Exposes node v8 garbage collection stats",
  "main": "dist/index.js",
  "repository": "",
  "license": "Unlicense",
  "engines": {
    "node": ">=6"
  },
  "scripts": {
    "install": "npx node-pre-gyp install --fallback-to-build",
    "test": "jest --config ./jest.config.js --collectCoverage --coverageDirectory=\"./coverage\" --ci --coverage --reporters=default --reporters=jest-junit",
    "example": "node --expose-gc example.js",
    "build": "npx node-pre-gyp build",
    "pretest": "npm run build",
    "clean": "npx node-pre-gyp clean",
    "configure": "npx node-pre-gyp configure",
    "build_babel": "babel lib -d dist",
    "lint": "npx eslint . --fix",
    "prettier": "npx prettier --check .",
    "prettier-format": "npx prettier --write ."
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "^1.0.9",
    "nan": "^2.16.0"
  },
  "gypfile": true,
  "devDependencies": {
    "@babel/cli": "^7.2.3",
    "@babel/core": "^7.18.5",
    "@babel/preset-env": "^7.3.1",
    "eslint": "^8.18.0",
    "expose-gc": "^1.0.0",
    "jest": "^28.1.1",
    "jest-junit": "^14.0.0",
    "mocha": "^9.2.2",
    "prettier": "2.7.1",
    "rewire": "^6.0.0",
    "semver": "^7.3.7",
    "should": "^13.2.3",
    "husky": "^8.0.0"
  },
  "binary": {
    "module_name": "native-stats",
    "module_path": "./build/{module_name}/v{version}/{configuration}/{node_abi}-{platform}-{arch}-{libc}",
    "remote_path": "./{module_name}/v{version}/{configuration}/",
    "package_name": "{node_abi}-{platform}-{arch}.tar.gz",
    "host": "https://www.site24x7.com"
  }
}
