{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 13
  },
  "ignorePatterns": ["test/**"],
  "globals": {
    "_typeof": "writable",
    "_get": "writable",
    "_setPrototypeOf": "writable",
    "_getPrototypeOf": "writable"
  },
  "rules": {
    "curly": "error",
    "no-func-assign": "warn",
    "quotes": ["error", "double"]
  }
}
